{
  "name": "@risklight/modal",
  "version": "0.1.0",
  "type": "module",
  "description": "Framework-agnostic modal stack with guards, typed prompts and Vue 3 and React adapters.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RiskLight/modal.git"
  },
  "homepage": "https://github.com/RiskLight/modal",
  "bugs": {
    "url": "https://github.com/RiskLight/modal/issues"
  },
  "keywords": [
    "modal",
    "dialog",
    "vue",
    "vue3",
    "vue-router",
    "focus-trap",
    "react"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "import": "./dist/dom/index.js",
      "default": "./dist/dom/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js",
      "default": "./dist/vue/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "lint": "oxlint src/ test/",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build && tsc -p tsconfig.build.json && cp src/style.css dist/style.css"
  },
  "peerDependencies": {
    "vue": "^3.3.0",
    "vue-router": "^4.0.0 || ^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.0.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@testing-library/react": "^16.3.0"
  }
}
